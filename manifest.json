{
  "schemaVersion": 1,
  "id": "badr-emil.rustdesk",
  "name": "RustDesk",
  "version": "1.1.0",
  "author": "Badr-Emil",
  "license": "MIT",
  "description": "Connect to and control remote PCs with RustDesk from the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "RustDeskPanel.qml"
  },
  "barWidget": {
    "displayName": "RustDesk",
    "description": "Shows your RustDesk ID, connects to partner IDs, and lists recent sessions for remote control or file transfer.",
    "category": "Network",
    "aliases": [
      "remote",
      "remote desktop",
      "rustdesk"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 10,
      "hideWhenIdle": false
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 10
      },
      {
        "key": "hideWhenIdle",
        "type": "boolean",
        "label": "Only show while a remote session is active",
        "defaultValue": false
      }
    ]
  }
}
